{
  "name": "celchat",
  "private": true,
  "version": "0.3.4",
  "description": "CelChat: a free, P2P-first, customizable community chat app",
  "type": "module",
  "license": "MIT",
  "author": "CelChat",
  "homepage": "https://devuaka.github.io/celchat/",
  "main": "desktop/main.cjs",
  "build": {
    "appId": "app.celchat.desktop",
    "productName": "CelChat",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "dist/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "npmRebuild": false,
    "protocols": [
      {
        "name": "CelChat invite",
        "schemes": [
          "celchat"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "client/public/icons/icon-256.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "CelChat"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.social-networking",
      "icon": "client/public/icons/icon-512.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network",
      "icon": "client/public/icons/icon-512.png"
    }
  },
  "scripts": {
    "desktop": "node scripts/build-variant.mjs serverless && electron .",
    "dist:desktop": "node scripts/build-variant.mjs serverless && electron-builder --win",
    "build:site": "node scripts/build-site.mjs",
    "publish": "node scripts/publish.mjs",
    "test:serverless": "node tests/e2e/serverless.mjs",
    "test:desktop": "node tests/e2e/desktop-smoke.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --config vite.config.ts",
    "dev:hub": "tsx watch --clear-screen=false hub/src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit && vite build --config vite.config.ts",
    "start": "tsx hub/src/index.ts",
    "keeper": "tsx keeper/src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/comfortaa": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/orbitron": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/lobster": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/righteous": "^5.3.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "emojibase-data": "^18.0.0",
    "highlight.js": "^11.12.0",
    "idb": "^8.0.4",
    "lucide-react": "^1.69.0",
    "mqtt": "^5.16.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "ws": "^8.22.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.64.1",
    "typescript": "5.9",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
