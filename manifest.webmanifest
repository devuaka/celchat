{
  "name": "CelChat",
  "short_name": "CelChat",
  "description": "Free, peer-to-peer community chat with voice, video, files and deep customization.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#0b1016",
  "theme_color": "#0b1016",
  "categories": ["social", "communication"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "protocol_handlers": [{ "protocol": "web+celchat", "url": "./#/join/%s" }],
  "shortcuts": [
    { "name": "Friends", "url": "./#/home", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
